# ScrapeHub — örnek ortam dosyası.
#   cp .env.example .env     (Windows: copy .env.example .env)
# sonra aşağıdaki zorunlu sırları kendi rastgele değerlerinizle doldurun.
# .env dosyası .gitignore'dadır; asla commit etmeyin.
#
# Rastgele değer üretmek için örnek:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Parolalarda yalnız harf/rakam kullanın (hex uygundur): REDIS_PASSWORD ve
# POSTGRES_PASSWORD bağlantı URL'lerinin içine yazılır; @ : / # gibi
# karakterler URL'yi bozar.

# --- Zorunlu sırlar ---
# Bilerek boş bırakıldı: doldurulmadan `docker compose` hangi değişkenin
# eksik olduğunu söyleyip durur (herkesin bildiği örnek parolayla çalışmasın diye).
API_KEY=
REDIS_PASSWORD=
POSTGRES_PASSWORD=
BROWSERLESS_TOKEN=
FLOWER_PASSWORD=

# --- İsteğe bağlı (gösterilen değerler varsayılandır) ---
# POSTGRES_USER=scrape
# POSTGRES_DB=scrapehub
# FLOWER_USER=admin

# API'nin dinlediği host adresi. 127.0.0.1 = yalnız bu makine.
# Ağdan erişim gerekiyorsa 0.0.0.0 yapın (API, API_KEY ile korunur).
# API_BIND_ADDR=127.0.0.1

# true ise GET veri uçları (ör. /books, /stats) anahtarsız okunabilir.
# PUBLIC_READ=false

# Virgülle ayrılmış izinli CORS kökenleri, ör. http://localhost:5173
# CORS_ORIGINS=

# true ise özel/yerel ağ adreslerinin kazınmasına izin verilir (SSRF riski).
# ALLOW_PRIVATE_NETWORKS=false

# API'nin tek bir işte kabul ettiği en büyük max_pages değeri (en az 1).
# Yükseltmek tek istekle daha uzun tarama ve daha çok yük demektir.
# MAX_PAGES_LIMIT=100

# Yerel Ollama sunucusu (AI ile ayrıştırma için)
# OLLAMA_URL=http://host.docker.internal:11434
